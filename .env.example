# Flask cookie signing. Random fallback exists for quick local testing, but set a stable value on Render.
SESSION_SECRET=replace-with-a-long-random-secret

# Preserves the requested 456456456 admin login. Change it before exposing the service publicly.
ADMIN_PASSCODE=456456456

# Existing Gemini key stays in Render Environment. Never put the key in HTML or in this file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Existing bank service is kept; routes must match your separate bank app.
BANK_SERVER_URL=https://sanal-banka.onrender.com

# Use true on Render (HTTPS); false is convenient for localhost development.
COOKIE_SECURE=false
